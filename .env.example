# ==============================================================================
# Project Shikayat Karo — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and customize values for your deployment environment.
# DO NOT commit real secrets or production .env files to source control.

# Application Environment (development | staging | production)
ENVIRONMENT=production

# Database Connection URL:
# For SQLite (local development): sqlite:///./shikayat_karo.db
# For PostgreSQL (Render / Supabase / Neon): postgresql://user:password@host:port/dbname
DATABASE_URL=sqlite:///./shikayat_karo.db

# JWT Authentication Secret Key (generate a secure random 64-character token in production)
# Example: openssl rand -hex 32
JWT_SECRET=replace_with_a_super_secret_jwt_key_for_production_min_32_chars

# Allowed CORS Origins (comma-separated list for production frontend)
# Include your Vercel deployment domain and local development ports:
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://shikayatkaro.vercel.app

# Embedding Engine for Categorisation & Similarity:
# - sentence-transformers: High-accuracy multilingual neural embeddings (~800MB model cache)
# - fastembed: Lightweight ONNX embeddings
# - fallback: Zero-dependency deterministic multilingual n-gram semantic hash (recommended for 512MB RAM free tiers)
EMBEDDER=sentence-transformers

# Testing Flag (set to 1 to disable background APScheduler during unit tests)
TESTING=0

# Server Host & Port
HOST=0.0.0.0
PORT=8000
