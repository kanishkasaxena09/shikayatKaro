# ==============================================================================
# Project Shikayat Karo (शिकायत Karo) — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure values for your deployment environment.
# Never commit actual secrets or credentials to source control.

# Application runtime environment: "development" or "production" (enforces strict JWT and CORS checks)
ENVIRONMENT=development

# Secret key for HS256 JWT tokens (required in production, auto-generated random ephemeral in development)
JWT_SECRET=replace_with_a_secure_random_32_plus_char_secret_in_production

# Database connection URL (SQLite for local dev, PostgreSQL for persistent multi-user production)
DATABASE_URL=sqlite:///./shikayat_karo.db

# Comma-separated list of allowed frontend origins (wildcard '*' is strictly forbidden in production)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,https://shikayatkaro.vercel.app

# Demo features toggle: "true" enables story simulator & persona switcher; "false" returns 403 on demo routes
DEMO_MODE=true

# Text embedding engine: "fastembed" (quantized ONNX ~150MB RAM), "fallback" (dictionary), "sentence-transformers" (PyTorch)
EMBEDDER=fastembed

# Maximum login attempts per client IP per 60 seconds before HTTP 429 is returned
RATE_LIMIT_LOGIN_PER_MINUTE=5

# Maximum anonymous tracking requests per client IP per 60 seconds before HTTP 429 is returned
RATE_LIMIT_TRACK_PER_MINUTE=10

# Minimum distinct parent incidents required at the same block to flag a recurring issue
RECURRING_INCIDENT_THRESHOLD=3

# Time window in days for detecting recurring incidents (virtual-clock aware)
RECURRING_WINDOW_DAYS=30

# Backend HTTP server listening host
HOST=0.0.0.0

# Backend HTTP server listening port
PORT=8000

# Testing flag: set to 1 during automated test runs to disable background APScheduler jobs
TESTING=0

# Frontend only: Base URL for backend API requests (leave empty when using Vite development proxy)
VITE_API_BASE_URL=
